  '--exclude[comma-separated categories to skip]:category:(zero-width invisible-format bidi variation-selector tag whitespace default-ignorable)' \
  '--min-severity[report only hits at or above LEVEL (info, low, medium, high; default i]:severity:(info low medium high)' \
  '--suspicious-only[shorthand for --min-severity medium: drop the annotated, likely-legiti]' \
  '--include-default-ignorables[also scan every remaining Unicode default-ignorable code point (noisy;]' \
  '--max-bytes[refuse inputs larger than N bytes (default 104857600; 0 = unlimited)]:value:' \
  '--max-hits[cap stored hit records at N to bound memory (default 200000; 0 = unlim]:value:' \
  '--show[max locations to list (default 20)]:value:' \
  '--list-categories[print the taxonomy and exit]' \
  '--version[show programs version number and exit]' \
  '*:file:_files'
