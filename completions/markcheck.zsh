#compdef markcheck
# markcheck zsh completion. Generated by tools/build_docs.py.
_arguments -s \
  '-h[show this help message and exit]' \
  '--help[show this help message and exit]' \
  '--strip[write a cleaned copy (FILE.clean.EXT) with hits removed]' \
  '--in-place[with --strip, overwrite the original (writes a .bak backup unless --no]' \
  '--no-backup[with --in-place, skip the .bak backup]' \
